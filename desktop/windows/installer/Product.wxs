<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
      Name="Прокси Дом"
      Manufacturer="Proxy Dom"
      Version="$(var.ProductVersion)"
      UpgradeCode="7C2A1B4E-6D3F-4A91-9E2B-1F6C8A0D4E27"
      Scope="perMachine"
      Language="1049"
      Codepage="1251">
    <!-- RemoveExistingProducts runs after the new files exist. The cached 1.0.1.14
         package still runs ProxyDomBroker.exe with reconcile from Program Files.
         That path is empty until InstallFiles of this package. -->
    <MajorUpgrade Schedule="afterInstallExecute" DowngradeErrorMessage="Уже установлена более новая версия." />
    <!-- Flutter keeps FileVersion 1.0.0+N. Equal versions would leave the old window in place. -->
    <Property Id="REINSTALLMODE" Value="amus" />
    <!-- Windows Installer otherwise picks the first drive with free space. On
         this machine that was a stale Z: mapping; costing it hangs forever.
         ROOTDRIVE must be a local volume, not a disconnected network drive. -->
    <Property Id="ROOTDRIVE" Value="C:\" />
    <!-- Windows Installer writes a verbose log to %TEMP%\MSI*.log by itself.
         Without this a hung sequence leaves no action name to read, which is
         exactly how the 1.5.8 install hang had to be diagnosed from event logs. -->
    <Property Id="MsiLogging" Value="voicewarmupx" />
    <MediaTemplate EmbedCab="yes" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.InstallerDir)\license.rtf" />

    <Feature Id="Main" Title="Прокси Дом" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="BrokerComponent" />
      <ComponentRef Id="StartMenuComponent" />
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Proxy Dom" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="Прокси Дом" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PayloadDir)\**">
        <Exclude Files="$(var.PayloadDir)\ProxyDomBroker.exe" />
      </Files>
    </ComponentGroup>

    <Component Id="BrokerComponent" Directory="INSTALLFOLDER" Guid="D4C7168B-5E2A-4D9F-A3B1-7C8E926F1045">
      <File Id="ServiceExe" Source="$(var.PayloadDir)\ProxyDomBroker.exe" KeyPath="yes" />
      <ServiceInstall
          Id="ProxyDomBrokerInstall"
          Name="ProxyDomBroker"
          DisplayName="Прокси Дом"
          Description="Локальный туннель Прокси Дом"
          Start="auto"
          Type="ownProcess"
          Account="LocalSystem"
          ErrorControl="normal"
          Vital="yes" />
      <!-- A killed service comes back and reconciles its own routes before the next connect. -->
      <util:ServiceConfig
          ServiceName="ProxyDomBroker"
          FirstFailureActionType="restart"
          SecondFailureActionType="restart"
          ThirdFailureActionType="restart"
          RestartServiceDelayInSeconds="5"
          ResetPeriodInDays="1" />
      <ServiceControl
          Id="ProxyDomBrokerControl"
          Name="ProxyDomBroker"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />
    </Component>

    <Component Id="StartMenuComponent" Directory="ProgramMenuDir" Guid="B8F4D2E3-5C69-401B-8D32-7E9F6C1B22A5">
      <Shortcut
          Id="StartMenuShortcut"
          Name="Прокси Дом"
          Description="Прокси Дом"
          Target="[INSTALLFOLDER]proxy_dom.exe"
          WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveProgramMenuDir" On="uninstall" />
      <RegistryValue
          Root="HKLM"
          Key="Software\Proxy Dom"
          Name="Installed"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcutComponent" Directory="DesktopFolder" Guid="C9A5E3F4-6D70-412C-9E43-8F0A7D2C33B6">
      <!-- No Icon attribute: the shell takes the icon from the target exe.
           MSI's Icon table copied the whole exe into the installer cache and
           failed with 2318/1909 during repair. The Start Menu shortcut already
           worked this way. -->
      <Shortcut
          Id="DesktopShortcut"
          Name="Прокси Дом"
          Description="Прокси Дом"
          Target="[INSTALLFOLDER]proxy_dom.exe"
          WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue
          Root="HKLM"
          Key="Software\Proxy Dom"
          Name="DesktopShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>

    <util:CloseApplication
        Id="CloseProxyDom"
        Target="proxy_dom.exe"
        Description="Прокси Дом"
        CloseMessage="yes"
        EndSessionMessage="yes"
        RebootPrompt="no"
        Timeout="5000"
        TerminateProcess="1" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <!-- StopServices (from ServiceControl) stops the broker synchronously before
         files are replaced. A pre-validate `sc stop` was removed: asyncNoWait
         let it land after StartServices and left the repaired service stopped. -->
    <!-- Old product uninstall stops the service that StartServices just started.
         Start again after that removal. Already-running is not a failed install. -->
    <CustomAction
        Id="StartBrokerAfterUpgrade"
        Directory="System64Folder"
        ExeCommand="sc.exe start ProxyDomBroker"
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />
    <InstallExecuteSequence>
      <Custom
          Action="StartBrokerAfterUpgrade"
          After="RemoveExistingProducts"
          Condition="NOT REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
