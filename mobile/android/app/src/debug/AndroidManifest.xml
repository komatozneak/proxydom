<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:usesCleartextTraffic="true">
        <!-- ТОЛЬКО ДЛЯ DEBUG: ручной старт VpnService без Flutter UI.
             НЕ имеет LAUNCHER intent-filter, чтобы не перехватывать главный запуск
             (Flutter run запускает MainActivity по умолчанию). Доступна через
             `adb shell am start -n com.teremok.connect.teremok_connect.debug/.DebugVpnActivity`.

             usesCleartextTraffic="true" разрешает HTTP (не HTTPS) к localhost/10.0.2.2
             для dev backend. В release этого не будет. -->
        <activity
            android:name=".DebugVpnActivity"
            android:exported="true"
            android:label="Teremok Debug VPN"/>
    </application>
</manifest>