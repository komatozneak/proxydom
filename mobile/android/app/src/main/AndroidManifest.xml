<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network: INTERNET is prot=dangerous on Android 17 (Pixel) — MainActivity
         also requests it at runtime. Missing grant → SocketException errno 13. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- VPN service permissions (Шаг 11) -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <!-- Keep Hy2 QUIC keep-alives alive after screen off (Doze otherwise
         idle-timeouts the tunnel while VpnService still reports connected). -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <application
        android:label="Прокси Дом"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="proxydom" android:host="add"/>
                <data android:scheme="proxydom" android:host="import"/>
                <data android:scheme="proxydom" android:host="sub"/>
            </intent-filter>
            <!-- Android App Links for the document host. A tap on
                 https://sub.proxydom.su/<token> in the system browser opens the
                 app instead of showing the raw Hysteria2 lines. Google verifies
                 this filter against the assetlinks.json the backend serves on
                 that same host, so the signing fingerprint in
                 ANDROID_APP_LINK_FINGERPRINTS has to match the installed build.
                 Verified links are handled by the SYSTEM, not by a WebView:
                 Telegram's in-app browser still shows the document text. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="sub.proxydom.su"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="teremok" android:host="add"/>
                <data android:scheme="teremok" android:host="import"/>
                <data android:scheme="teremok" android:host="sub"/>
            </intent-filter>
            <!-- Server keys shared from another app or tapped in a chat. Without
                 this filter the only way in is copy-paste: the OS has no handler
                 for `vless://` and the link lands in a browser that cannot open
                 it. Only schemes this build can actually start are registered;
                 a key it would have to refuse is not an intake path.
                 `ss` and `socks5` have no host, so the filter matches any. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="hysteria2"/>
                <data android:scheme="hy2"/>
                <data android:scheme="vless"/>
                <data android:scheme="vmess"/>
                <data android:scheme="trojan"/>
                <data android:scheme="ss"/>
                <data android:scheme="socks5"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES"/>
            </intent-filter>
        </activity>

        <!-- Override TrustTunnel AAR VpnPrepareActivity so Android 16 does not
             see a fixed orientation on large screens; app manifest wins merge. -->
        <activity
            android:name="com.adguard.trusttunnel.VpnPrepareActivity"
            android:exported="false"
            android:resizeableActivity="true"
            tools:replace="android:resizeableActivity" />

        <!-- VpnService as FGS specialUse (targetSdk 34+). systemExempted requires
             privileged FOREGROUND_SERVICE_SYSTEM_EXEMPTED — crashes on normal apps. -->
        <service
            android:name=".ProxyDomVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService"/>
            </intent-filter>
            <!-- Ogon-style opt-out — grey Always-on / lockdown for Proxy Dom. -->
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="false"/>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn"/>
        </service>

        <receiver
            android:name=".VpnActionReceiver"
            android:exported="false" />

        <service
            android:name=".ProxyDomTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_vpn"
            android:label="@string/qs_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true"/>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true"/>
            <meta-data
                android:name="android.service.quicksettings.TILE_CATEGORY"
                android:value="android.service.quicksettings.CONNECTIVITY"/>
        </service>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher: open APK download / changelog links in browser -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
        <!-- Kill switch: Settings.ACTION_VPN_SETTINGS (package visibility API 30+) -->
        <intent>
            <action android:name="android.settings.VPN_SETTINGS"/>
        </intent>
        <!-- Split-tunnel Apps tab: launcher inventory without QUERY_ALL_PACKAGES -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>
</manifest>